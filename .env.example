# 复制成 .env.local 后填上真值（.env.local 已被 .gitignore 忽略，不会进仓库）。
#
#   cp .env.example .env.local
#
# 这两个值只用于**构建期静态替换**（Vite 的 import.meta.env.VITE_*），
# 改完要重启 dev server 或重新 build 才生效。
# scripts/gen-installers.mjs 也会读它们，把端点写进 public/install.sh 与 public/install.ps1。

# 后端 = Supabase。建表 SQL 见 supabase/migrations/001-skills.sql
# 与主站（jerry-site）/ jerry-tools 共用同一个项目。
VITE_SUPABASE_URL=https://swdnendmdmcyqnnjzytv.supabase.co

# anon key。**它是公开的**（会被打进前端 bundle、也会写进两个安装脚本，
# 本来就是给浏览器 / 命令行用的），所以放 .env.local 只是为了让「换项目」不用改代码。
# 真正拦权限的是 RLS（本项目的表对所有角色关闭）+ 函数里的体积与频率校验。
# ⚠️ 绝对不要把 service_role key 填在这里 —— 那个能绕过 RLS。
VITE_SUPABASE_ANON_KEY=

# 站点自身的公开地址（用于拼接「复制安装」里那条命令 —— macOS/Linux 的 curl、
# Windows 的 PowerShell 都用它）。
# 留空则前端用 location.origin + BASE_URL 现算，本地开发无需配置。
VITE_SITE_URL=
